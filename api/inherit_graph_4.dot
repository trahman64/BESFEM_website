digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="ConcentrationBase",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classConcentrationBase.html",tooltip="Abstract base class for BESFEM concentration solvers."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="ElectrodeCahnHilliard",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classElectrodeCahnHilliard.html",tooltip="Solves solid-phase electrode concentration using a Cahn-Hilliard model."];
  Node0 -> Node2 [id="edge2_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="ElectrodeDiffusion",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classElectrodeDiffusion.html",tooltip="Solves solid-state lithium diffusion within electrode particles."];
  Node0 -> Node3 [id="edge3_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="ElectrolyteDiffusion",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classElectrolyteDiffusion.html",tooltip="Solves electrolyte salt transport in BESFEM battery simulations."];
}
