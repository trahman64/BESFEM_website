digraph "PotentialBase"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="PotentialBase",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Abstract base class for BESFEM electric-potential solvers."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="ElectrodePotential",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classElectrodePotential.html",tooltip="Solves the solid-phase electric potential within an electrode."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="ElectrolytePotential",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classElectrolytePotential.html",tooltip=" "];
}
