digraph "ConcentrationBase"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="ConcentrationBase",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Abstract base class for BESFEM concentration solvers."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="ElectrodeCahnHilliard",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classElectrodeCahnHilliard.html",tooltip="Solves solid-phase electrode concentration using a Cahn-Hilliard model."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="ElectrodeDiffusion",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classElectrodeDiffusion.html",tooltip="Solves solid-state lithium diffusion within electrode particles."];
  Node1 -> Node4 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="ElectrolyteDiffusion",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classElectrolyteDiffusion.html",tooltip="Solves electrolyte salt transport in BESFEM battery simulations."];
}
